{
  "name": "Python 3.12 - FastAPI Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // extraHosts 不是 devcontainer.json 的有效欄位，要改用 runArgs
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "forwardPorts": [
    8000,
    8001
  ],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "RooVeterinaryInc.roo-cline"
      ]
    }
  },
  "postCreateCommand": "pip install -e . && pytest --version",
  // 每次連線都重新建立 rg 連結（VS Code 更新後路徑會變）
  "postAttachCommand": "bash .devcontainer/fix-rg.sh",
  "shutdownAction": "stopContainer"
}